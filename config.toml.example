[app]
title = "LLM Bot"
app_name = "bot"
description = "Telegram bot with LLM"
version = "0.0.1"

[logging]
level = "INFO"
json_logs = false

[openrouter]
api_key = ""
base_url = "https://openrouter.ai/api/v1"
model = "qwen/qwen3-next-80b-instruct"
temperature = 0.1
max_tokens = 512
system_prompt = "Ты - полезный ассистент в Telegram боте. Общайся с пользователями дружелюбно и помогай решать их вопросы.Важные правила:1. Отвечай на языке, на котором тебе задали вопрос 2.История диалога предоставляется только для понимания контекста вопроса. Вопрос пользователя задан в последнем сообщении от него 3.Отвечай в формате Telegram сообщения 4.Если информации недостаточно - запроси уточнение. Твоя задача - помогать пользователям с их запросами, используя предоставленный контекст переписки."

[telegram]
token = ""
bot_name = ""
max_history = 10

[database]
host = "postgres"
port = 5432
user = "postgres"
password = "12345678"
database = "postgres"
bouncer = false

[agno]
name = "Agno Assist"
model_id=""
db_url="postgresql+psycopg://postgres:postgres@postgres:5432/postgres"
mcp_url="https://docs.agno.com/mcp"
add_datetime_to_context=true
add_history_to_context=true
num_history_runs=3
markdown=true
api_key = ""
base_agno_url=""