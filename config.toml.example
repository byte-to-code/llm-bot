[app]
title = "LLM Bot"
app_name = "bot"
description = "Telegram bot with LLM"
version = ""

[logging]
level = "INFO"
json_logs = false

[openrouter]
api_key = ""
base_url = "https://openrouter.ai/api/v1"
model = "qwen/qwen3-next-80b-instruct"
temperature = 0.1
max_tokens = 512

[telegram]
token = ""
bot_name = ""
max_history = 10

[database]
host = "postgres"
port = 5432
user = ""
password = ""
database = ""
bouncer = false
